{
  "name": "hetzner-cloud-radar",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node src/scripts/migrate.mjs",
    "db:setup:local": "node src/scripts/setup-local-db.mjs && pnpm db:migrate",
    "db:studio": "drizzle-kit studio",
    "resend:migrate-filter-topics": "node src/scripts/migrate-resend-filter-topics.mjs",
    "families:audit": "node src/scripts/audit-server-families.mjs",
    "email": "email dev --dir ./src/emails --port 3001",
    "worker": "tsx worker.ts"
  },
  "dependencies": {
    "@react-email/components": "^1.0.12",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-query": "^5.100.9",
    "drizzle-orm": "^0.45.2",
    "next": "16.2.4",
    "postgres": "^3.4.9",
    "posthog-js": "^1.407.8",
    "posthog-node": "^5.46.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.12.3",
    "tsx": "^4.23.11",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@react-email/ui": "6.1.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "react-email": "^6.1.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
